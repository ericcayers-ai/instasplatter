{
  "name": "instasplatter",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "fmt:rust": "cd src-tauri && cargo fmt --check",
    "test:rust": "cd src-tauri && cargo test --locked",
    "smoke": "powershell -ExecutionPolicy Bypass -File tools/smoke-local.ps1",
    "smoke:static": "npx tsx src/splat/frustum.smoke.ts && npx tsx src/geospatial/precision.smoke.ts && npx tsx src/geospatial/hazards/floodValidation.smoke.ts && npx tsx src/geospatial/pointSplatFloodVps.smoke.ts && npx tsx src/lib/captureInput.smoke.ts && npx tsx src/geospatial/preview/domainCap.smoke.ts",
    "bench": "node tools/bench/run-bench.mjs --count 300000 --frames 15",
    "bench:wide": "node tools/bench/run-bench.mjs --count 1000000 --frames 10 --wide",
    "bench:vps-ui": "node tools/bench/vps-receipt.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "cesium": "^1.143.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.14",
    "@tauri-apps/cli": "^2.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.2.2",
    "vite-plugin-cesium": "^1.2.23"
  }
}
