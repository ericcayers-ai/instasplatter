{
  "name": "instasplatter",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate",
    "clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "fmt:rust": "cd src-tauri && cargo fmt --check",
    "test:rust": "cd src-tauri && cargo test --locked",
    "smoke": "powershell -ExecutionPolicy Bypass -File tools/smoke-local.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "cesium": "^1.143.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.14",
    "@tauri-apps/cli": "^2.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.0.14",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.2.2",
    "vite-plugin-cesium": "^1.2.23"
  }
}
